<script>
const C = {
  JADIASN: '#2D5BFF', STUDI: '#10B981', AYO: '#F59E0B', ID: '#8B5CF6',
  ALFAIZ: '#EC4899', VIRACUN: '#0EA5E9', SANGTUTOR: '#F97316',
  RED: '#EF4444',
};
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun'];
Chart.defaults.font.family = "'Segoe UI', system-ui, sans-serif";
Chart.defaults.font.size = 12;
Chart.defaults.color = '#64748B';
const defOpts = {
  responsive: true, maintainAspectRatio: false,
  plugins: { legend: { position: 'bottom', labels: { padding: 12, usePointStyle: true, pointStyle: 'circle', font: { size: 11 } } } },
  scales: { y: { grid: { color: '#F1F5F9' }, border: { display: false } }, x: { grid: { display: false }, border: { display: false } } }
};
function ln(label, data, color, fill) {
  return { label, data, borderColor: color, backgroundColor: color+'18', fill: !!fill, tension: 0.3, pointRadius: 4, borderWidth: 2.2 };
}

// 1. IG Followers Trend (6 akun)
new Chart(document.getElementById('igFollowersChart'), {
  type: 'line',
  data: { labels: months, datasets: [
    ln('@studicpns.id', [520000,545000,570000,600000,635000,671595], C.STUDI),
    ln('@jadiasnofficial', [575500,576100,576800,577400,578100,578694], C.JADIASN),
    ln('@privatalfaiz', [502000,509000,516500,524000,531500,545175], C.ALFAIZ),
    ln('@idcpns', [535200,536400,537600,538800,539900,541049], C.ID),
    ln('@ayocpns', [370000,370200,370500,370700,370900,371173], C.AYO),
    ln('@viracun.id', [226000,233200,240400,247600,254800,269275], C.VIRACUN),
  ]},
  options: { ...defOpts, plugins: { ...defOpts.plugins, tooltip: { callbacks: { label: c => c.dataset.label+': '+c.raw.toLocaleString('id-ID') } } },
    scales: { ...defOpts.scales, y: { ...defOpts.scales.y, ticks: { callback: v=>(v/1000).toFixed(0)+'K' }, title: { display: true, text: 'Followers' } } } }
});

// 2. IG Growth/Month
new Chart(document.getElementById('igGrowthChart'), {
  type: 'bar',
  data: { labels: months, datasets: [
    { label: '@studicpns.id', data: [18000,25000,25000,30000,35000,36595], backgroundColor: C.STUDI, borderRadius: 3 },
    { label: '@privatalfaiz', data: [6500,7000,7500,7500,7500,7350], backgroundColor: C.ALFAIZ, borderRadius: 3 },
    { label: '@viracun.id', data: [6800,7200,7200,7200,7200,7200], backgroundColor: C.VIRACUN, borderRadius: 3 },
    { label: '@idcpns', data: [1100,1200,1200,1200,1100,1149], backgroundColor: C.ID, borderRadius: 3 },
    { label: '@jadiasnofficial', data: [650,600,700,600,700,594], backgroundColor: C.JADIASN, borderRadius: 3 },
    { label: '@ayocpns', data: [200,200,300,200,200,273], backgroundColor: C.AYO, borderRadius: 3 },
  ]},
  options: { ...defOpts, scales: { ...defOpts.scales, y: { ...defOpts.scales.y, ticks: { callback: v=>v>=1000?(v/1000).toFixed(0)+'K':v }, title: { display: true, text: 'Net Gain/Bulan' } } } }
});

// 3. IG Engagement Rate (horizontal bar, sorted desc)
new Chart(document.getElementById('igEngagementChart'), {
  type: 'bar',
  data: {
    labels: ['@viracun.id', '@studicpns.id', '@privatalfaiz', '@idcpns', '@ayocpns', '@jadiasnofficial'],
    datasets: [{ label: 'Engagement Rate (%)', data: [0.96, 0.43, 0.17, 0.09, 0.07, 0.02],
      backgroundColor: [C.VIRACUN, C.STUDI, C.ALFAIZ, C.ID, C.AYO, C.RED], borderRadius: 5, barThickness: 32 }]
  },
  options: { ...defOpts, indexAxis: 'y', plugins: { ...defOpts.plugins, legend: { display: false },
    tooltip: { callbacks: { label: c=>'Engagement: '+c.raw+'%' } } },
    scales: { x: { grid: { color:'#F1F5F9' }, border: { display: false }, title: { display: true, text: 'Engagement Rate (%)' } }, y: { grid: { display: false }, border: { display: false } } } }
});

// 4. IG Posting Volume
new Chart(document.getElementById('igPostingChart'), {
  type: 'bar',
  data: { labels: months, datasets: [
    { label: '@jadiasnofficial', data: [105,110,115,108,112,110], backgroundColor: C.JADIASN, borderRadius: 3 },
    { label: '@studicpns.id', data: [85,88,90,92,90,88], backgroundColor: C.STUDI, borderRadius: 3 },
    { label: '@privatalfaiz', data: [48,50,52,50,50,48], backgroundColor: C.ALFAIZ, borderRadius: 3 },
    { label: '@idcpns', data: [28,30,32,30,30,32], backgroundColor: C.ID, borderRadius: 3 },
    { label: '@ayocpns', data: [22,24,25,23,25,22], backgroundColor: C.AYO, borderRadius: 3 },
    { label: '@viracun.id', data: [8,10,8,7,6,2], backgroundColor: C.VIRACUN, borderRadius: 3 },
  ]},
  options: { ...defOpts, scales: { ...defOpts.scales, y: { ...defOpts.scales.y, title: { display: true, text: 'Post / Bulan' } } } }
});

// 5. Avg Likes (horizontal bar, sorted desc)
new Chart(document.getElementById('igLikesChart'), {
  type: 'bar',
  data: {
    labels: ['@studicpns.id', '@viracun.id', '@privatalfaiz', '@idcpns', '@ayocpns', '@jadiasnofficial'],
    datasets: [{ label: 'Avg Likes/Post', data: [2511, 2483, 830, 407, 209, 85],
      backgroundColor: [C.STUDI, C.VIRACUN, C.ALFAIZ, C.ID, C.AYO, C.RED], borderRadius: 5, barThickness: 32 }]
  },
  options: { ...defOpts, indexAxis: 'y', plugins: { ...defOpts.plugins, legend: { display: false },
    tooltip: { callbacks: { label: c=>'Avg Likes: '+c.raw.toLocaleString('id-ID') } } },
    scales: { x: { grid: { color:'#F1F5F9' }, border: { display: false }, title: { display: true, text: 'Avg Likes per Post' } }, y: { grid: { display: false }, border: { display: false } } } }
});

// 6. TikTok Followers Trend (7 akun)
new Chart(document.getElementById('ttFollowersChart'), {
  type: 'line',
  data: { labels: months, datasets: [
    ln('@jadiasnofficial', [1280000,1285000,1290000,1295000,1298000,1300000], C.JADIASN, true),
    ln('@privatalfaiz', [867000,875000,882500,890000,897500,912400], C.ALFAIZ),
    ln('@vr_maghfirah', [481000,496000,511000,526000,541000,571000], C.VIRACUN),
    ln('@sang_tutor', [356000,361000,365000,370000,375000,383500], C.SANGTUTOR),
    ln('@ayocpns', [133000,134000,134500,135000,135500,135700], C.AYO),
    ln('@idcpns', [72000,72500,73000,73200,73300,73300], C.ID),
    ln('@studicpns.id', [50000,52000,54000,55500,57000,58200], C.STUDI),
  ]},
  options: { ...defOpts, plugins: { ...defOpts.plugins,
    tooltip: { callbacks: { label: c=>c.dataset.label+': '+(c.raw>=1e6?(c.raw/1e6).toFixed(2)+'M':(c.raw/1e3).toFixed(1)+'K') } } },
    scales: { ...defOpts.scales, y: { ...defOpts.scales.y, ticks: { callback: v=>v>=1e6?(v/1e6).toFixed(1)+'M':(v/1e3).toFixed(0)+'K' }, title: { display: true, text: 'Followers' } } } }
});

// 7. TikTok Likes (doughnut)
const ttTotal = 10600000+9700000+6200000+2200000+1300000+549300+361800;
new Chart(document.getElementById('ttLikesChart'), {
  type: 'doughnut',
  data: {
